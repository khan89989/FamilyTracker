<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Parent Profile Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/btnHomeParent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;"
            android:textSize="24sp"
            android:padding="4dp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/ivParentProfile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:src="@android:drawable/ic_menu_gallery"
            android:layout_marginEnd="12dp"/>

        <!-- This layout holds the name, edit button, and sync status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/tvParentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parent Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Row for Edit button and Sync Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnEditParentProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    style="?attr/materialButtonOutlinedStyle"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvBackupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Ready"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Child Device Toggle -->
    <Switch
        android:id="@+id/switchIsChildDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mark this phone as Child Device (Enables Adhan)"
        android:textSize="14sp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSetupDrive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minHeight="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Setup Google Drive Backup Folder"
        android:textSize="10sp" />

    <Button
        android:id="@+id/btnPrayerSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prayer Settings (Location &amp; Adhan)"
        android:textSize="10sp"
        android:minHeight="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnAddChild"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Child Account"
            android:textSize="10sp"
            android:minHeight="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnAddParent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Parent Account"
            android:textSize="10sp"
            android:minHeight="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Children:"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChildren"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnLogoutParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:minHeight="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_marginTop="8dp" />

</LinearLayout>