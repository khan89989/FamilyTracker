<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="#F9F9F9"
    android:elevation="1dp">

    <TextView
        android:id="@+id/tvHwTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assignment Title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHwNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notes..."
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvStatusTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: PENDING"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvHelpMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Help Message"
        android:textSize="14sp"
        android:textColor="#4CAF50"
        android:textStyle="italic"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvHelpAttachment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📎 Attachment Attached"
        android:textSize="14sp"
        android:textColor="#2196F3"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnProvideHelp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="❓"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:backgroundTint="#FF9800"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEditAssignment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✏️"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:backgroundTint="#2196F3"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDeleteAssignment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗑️"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:backgroundTint="#F44336"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnResetAssignment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔄"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:backgroundTint="#9E9E9E" />
    </LinearLayout>
</LinearLayout>